# =============================================================
# PDFKing – Beispiel-Umgebungsvariablen
#
# Kopiere diese Datei nach `.env.local` und passe die Werte an.
# Trage NIEMALS echte Geheimnisse in das Git-Repository ein!
# Alle Variablen sind optional – ohne Konfiguration läuft die
# App vollständig mit lokaler Browser-Verarbeitung.
# =============================================================

# --- Optionaler Backend-Dienst für Server-Konvertierungen ----
# Basis-URL eines externen Konvertierungsdienstes (z. B. LibreOffice-
# basierter Dienst). Nur nötig für Funktionen, die nicht zuverlässig
# im Browser laufen: DOCX/PPTX/XLSX -> PDF sowie hochwertiges PDF -> DOCX.
# Solange diese Variable leer ist, zeigt die App diese Funktionen als
# "Server erforderlich – nicht eingerichtet" an.
SERVER_PROCESSING_URL=

# Gemeinsames Bearer-Token zwischen App und Backend (serverseitig).
# Wird ausschließlich serverseitig gelesen und nie an den Browser
# übermittelt. Erzeuge z. B. mit: openssl rand -hex 32
SERVER_PROCESSING_TOKEN=

# Maximale Upload-Größe in Megabytes (client- UND serverseitig geprüft).
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Öffentliche URL der App (z. B. für Metadaten/Manifest bei Hosting).
NEXT_PUBLIC_APP_URL=http://localhost:3000
