{
  "name": "CoroaPDF – PDF-Werkzeuge",
  "short_name": "CoroaPDF",
  "description": "PDFs lesen, bearbeiten, organisieren, komprimieren, unterschreiben und konvertieren – lokal im Browser.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#08783f",
  "lang": "de",
  "icons": [
    {
      "src": "/icons/icon-192.png?v=6",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=6",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/tools/lesen?quelle=datei",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}
